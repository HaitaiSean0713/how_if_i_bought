{
  "entities": {
    "Portfolio": {
      "title": "Portfolio",
      "description": "User's investment portfolio containing active and closed positions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the portfolio."
        },
        "userId": {
          "type": "string",
          "description": "The user ID of the portfolio owner."
        },
        "name": {
          "type": "string",
          "description": "Name of the portfolio."
        },
        "positions": {
          "type": "array",
          "description": "Active positions in the portfolio."
        },
        "closedPositions": {
          "type": "array",
          "description": "Closed positions in the portfolio."
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated timestamp."
        }
      },
      "required": ["id", "userId", "name", "positions", "closedPositions"]
    }
  },
  "firestore": {
    "portfolios/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Stores user investment portfolios."
    }
  }
}
